generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  SUBMITTED
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CARD
  PAY_ON_ARRIVAL
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cartItems    CartItem[]
  orders       Order[]
}

model CartItem {
  id              Int      @id @default(autoincrement())
  userId          Int
  productId       String
  productName     String
  productImageUrl String?
  unitPrice       Float
  quantity        Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Order {
  id                Int               @id @default(autoincrement())
  userId            Int
  status            OrderStatus       @default(PENDING)
  subtotal          Float
  fulfillmentMethod FulfillmentMethod
  paymentMethod     PaymentMethod
  deliveryAddress   String?
  pickupLocation    String?
  contactPhone      String?
  notes             String?
  cardholderName    String?
  cardLast4         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             OrderItem[]

  @@index([userId])
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  productId       String
  productName     String
  productImageUrl String?
  unitPrice       Float
  quantity        Int
  lineTotal       Float
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Product {
  id             String   @id
  name           String
  subtitle       String
  description    String?
  images         String
  image          String
  href           String
  currency       String   @default("USD")
  basePrice      Float
  salePrice      Float?
  compareAtPrice Float?
  inventoryStatus String  @default("in_stock")
  inventoryLabel String
  category       String?
  department     String
  tags           String?
  gender         String
  dietary        String?
  variants       String?
  rating         Float?
  reviewCount    Int      @default(0)
  inventory      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([inventoryStatus, isActive])
}

model Review {
  id          Int      @id @default(autoincrement())
  productId   String
  displayName String
  rating      Int
  title       String?
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([createdAt])
}
